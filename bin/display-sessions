#!/bin/bash

# Icon glyphs (nerd font)
SESSION_GLYPH=""    # terminal/active tmux sessions
TMUXP_GLYPH=""     # gear, tmuxp sessions
ZOXIDE_GLYPH=""    # folder, zoxide entries

# Icon colors - pulled from the terminal's own ANSI palette (tput setaf N),
# so they follow whatever theme the terminal is set to.
# N: 0 black  1 red  2 green  3 yellow  4 blue  5 magenta  6 cyan  7 white  8-15 bright variants
COLOR_SESSION=$(tput setaf 2)   # green
COLOR_TMUXP=$(tput setaf 7)     # grey
COLOR_ZOXIDE=$(tput setaf 4)    # blue
COLOR_RESET=$(tput sgr0)

SESSION_ICON="${COLOR_SESSION}${SESSION_GLYPH}${COLOR_RESET}"
TMUXP_ICON="${COLOR_TMUXP}${TMUXP_GLYPH}${COLOR_RESET}"
ZOXIDE_ICON="${COLOR_ZOXIDE}${ZOXIDE_GLYPH}${COLOR_RESET}"

# Get the current tmux session
CURRENT_SESSION=$(tmux display-message -p '#S')

# List active tmux sessions and prepend the icon, excluding the current session
SESSIONS=$(tmux list-sessions -F "#{session_name}" | grep -v "^$CURRENT_SESSION$" | sed "s/^/$SESSION_ICON /")

# List tmuxp sessions from the .config/tmuxp directory, excluding active ones and the current session
# and only including those with valid start_directory paths
TMUXP_DIR="$HOME/.config/tmuxp"
TMUXP_SESSIONS=""
if [ -d "$TMUXP_DIR" ]; then
  while IFS=$'\t' read -r file session_name start_directory; do
    file_name=$(basename "$file" .yaml)

    # Expand tilde (~) to the full home directory path
    start_directory="${start_directory/#\~/$HOME}"

    # Check if the session is not active (including the current session) and if the start_directory exists
    if [ -d "$start_directory" ] && ! echo "$SESSIONS" | grep -q -F "$session_name" && [ "$session_name" != "$CURRENT_SESSION" ]; then
      TMUXP_SESSIONS+="$TMUXP_ICON $session_name ($file_name)"$'\n'
    fi
  done < <(awk -F': *' '
    FNR==1 { if (fn) print fn"\t"sn"\t"sd; fn=FILENAME; sn=""; sd="" }
    /^session_name:/ { sn=$2; gsub(/^"|"$/,"",sn) }
    /^start_directory:/ { sd=$2; gsub(/^"|"$/,"",sd) }
    END { if (fn) print fn"\t"sn"\t"sd }
  ' "$TMUXP_DIR"/*.yaml)
fi

# List zoxide entries using `zoxide query -l` and replace the full home path with ~
# Use the full zoxide entry path for tmux session names
ZOXIDE_ENTRIES=$(zoxide query -l | awk -v home="$HOME" '{gsub(home, "~"); print "'$ZOXIDE_ICON' " $0}')

# Combine the session lists
COMBINED_SESSIONS=$(echo -e "$SESSIONS\n$TMUXP_SESSIONS$ZOXIDE_ENTRIES")

# Display the sessions in a fzf popup and allow the user to select one
SELECTED_SESSION=$(echo -e "$COMBINED_SESSIONS" | \
  fzf --ansi \
    --layout=reverse \
    --style full \
    --border \
    --border-label ' Select a Session ' \
    --input-label ' Query ' \
    --color 'border:#a6e3a1,label:#a6e3a1,input:#ccccff' \
    --color 'list-border:#89b4fa,list-label:#89b4fa' \
    --color 'input-border:#89b4fa,input-label:#89b4fa' \
    --color 'header-border:#6699cc,header-label:#99ccff' \
    --multi)

# Exit if no session is selected (Escape or empty selection)
if [ -z "$SELECTED_SESSION" ]; then
  exit 0
fi

# Strip the icon and session name (with file name) from the selected session
# Format: "ICON session_name (file_name)" or "ICON zoxide_entry"
STRIPPED_SESSION="${SELECTED_SESSION#* }"
SESSION_NAME=$(echo "$STRIPPED_SESSION" | sed -e 's/ (.*)//')
FILE_NAME=$(echo "$STRIPPED_SESSION" | sed -e 's/.* (\(.*\))$/\1/')
ZOXIDE_PATH="$STRIPPED_SESSION"

# Handle tmux session or tmuxp session or zoxide entry
if echo "$SESSIONS" | grep -q -F "$SESSION_NAME"; then
  # Switch to the selected tmux session
  tmux switch-client -t "$SESSION_NAME"
elif echo "$TMUXP_SESSIONS" | grep -q -F "$SESSION_NAME"; then
  # Load the tmuxp session in detached mode using the file name
  if tmuxp load -d "$TMUXP_DIR/$FILE_NAME.yaml"; then
    # Immediately switch to the newly loaded session
    tmux switch-client -t "$SESSION_NAME"
  else
    echo "Failed to load tmuxp session from file: $TMUXP_DIR/$FILE_NAME.yaml" >&2
    exit 1
  fi
elif [ -n "$ZOXIDE_PATH" ]; then
  # Route zoxide entries to a single "Miscellaneous" session
  FINAL_PATH=$(eval echo "$ZOXIDE_PATH")
  MISC_SESSION="Miscellaneous"
  # Check if the Miscellaneous session exists
  if ! tmux has-session -t "$MISC_SESSION" 2>/dev/null; then
    # Create the session if it does not exist
    tmux new-session -d -s "$MISC_SESSION" -c "$FINAL_PATH" -n "$ZOXIDE_PATH"
  else
    # Check if a window with this name already exists in the Miscellaneous session
    EXISTING_WINDOW=$(tmux list-windows -t "$MISC_SESSION" -F '#{window_name}' | grep -Fx "$ZOXIDE_PATH" | head -n 1)
    if [ -n "$EXISTING_WINDOW" ]; then
      # Window exists, switch to it
      tmux select-window -t "$MISC_SESSION:$ZOXIDE_PATH"
    else
      # Window doesn't exist, create a new window
      WINDOW_ID=$(tmux new-window -P -F '#{window_id}' -t "$MISC_SESSION:" -c "$FINAL_PATH" -n "$ZOXIDE_PATH")
      tmux set-window-option -t "$WINDOW_ID" default-path "$FINAL_PATH" 2>/dev/null || true
    fi
  fi
  # Switch to the Miscellaneous session (the target window will be active there)
  tmux switch-client -t "$MISC_SESSION"
else
  echo "No matching tmux, tmuxp, or zoxide entry found for: $SESSION_NAME" >&2
  exit 1
fi


